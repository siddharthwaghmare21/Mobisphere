# Mobisphere OTP integration settings

# SendGrid email settings
SENDGRID_API_KEY=
SENDGRID_FROM=Mobisphere <noreply@mobisphere.com>

# Twilio SMS settings
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1234567890

# Shared OTP signing secret
OTP_SECRET=replace-with-a-strong-secret

# Set this to true while developing to receive OTP codes in the browser response
NEXT_PUBLIC_SHOW_OTP=true
